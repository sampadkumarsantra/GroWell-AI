# =====================================================
# GroWell AI — environment
#
# Copy to .env and fill in. Never commit a real .env.
# =====================================================


# ---------- DATABASE ----------

# REQUIRED. Paid subscriptions live here. A local file DB is not
# safe for billing — a redeploy would silently cancel paying
# customers.
#
# Local:  postgresql://postgres:postgres@localhost:5432/growell
# Render: supplied automatically from the attached database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growell

# Set to false for a local Postgres with no TLS.
DATABASE_SSL=false


# ---------- AUTH ----------

# REQUIRED IN PRODUCTION. Without this the server falls back to a
# publicly known value, which means anyone can forge a session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GOOGLE_CLIENT_ID=


# ---------- PAYMENTS (Razorpay) ----------

# From Razorpay Dashboard → Account & Settings → API Keys.
# Use the LIVE keys (rzp_live_...) in production; test keys
# (rzp_test_...) never move real money. Without these the app
# still runs, but the upgrade page reports checkout unavailable.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard → Settings → Webhooks. Must match exactly, or
# every webhook is rejected and no one ever gets Premium.
RAZORPAY_WEBHOOK_SECRET=

# Subscriptions → Plan (create it in LIVE mode). Must be a
# recurring, monthly, INR plan whose amount equals the price the
# app shows (9900 paise = Rs 99.00). The plan amount — not this
# file — is what the customer is actually charged.
RAZORPAY_PREMIUM_PLAN_ID=


# ---------- AI ----------

GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash


# ---------- MARKET DATA (data.gov.in / AGMARKNET) ----------

# CKAN resource id for the Ministry of Agriculture AGMARKNET daily
# commodity price dataset published on data.gov.in.
# Dataset: "Current daily price of various commodities from various markets (Mandi)"
# Verified resource: 9ef84268-d588-465a-a308-a864a43d0070
DATAGOV_AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
