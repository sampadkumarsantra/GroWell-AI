# =====================================================
# GroWell AI — environment
#
# Copy to .env and fill in. Never commit a real .env.
# =====================================================


# ---------- DATABASE ----------

# REQUIRED. Paid subscriptions live here. A local file DB is not
# safe for billing — a redeploy would silently cancel paying
# customers.
#
# Local:  postgresql://postgres:postgres@localhost:5432/growell
# Render: supplied automatically from the attached database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/growell

# Set to false for a local Postgres with no TLS.
DATABASE_SSL=false


# ---------- AUTH ----------

# REQUIRED IN PRODUCTION. Without this the server falls back to a
# publicly known value, which means anyone can forge a session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

GOOGLE_CLIENT_ID=


# ---------- PAYMENTS (Razorpay) ----------

# From Razorpay Dashboard → Settings → API Keys.
# Without these the app still runs; the upgrade page reports that
# checkout is unavailable rather than failing at payment time.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# From Dashboard → Settings → Webhooks. Must match exactly, or
# every webhook is rejected and no one ever gets Premium.
RAZORPAY_WEBHOOK_SECRET=

# Subscriptions → Plan. This is the monthly price in paise.
# 49900 = Rs 499.00
RAZORPAY_PREMIUM_PLAN_ID=


# ---------- AI ----------

GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash


# ---------- MANDI PRICE SOURCE ----------

# Agmarknet, the Directorate of Marketing & Inspection, read
# directly from its own API. No key or token is required.
AGMARKNET_API_URL=

# Which states to ask Agmarknet about, as the numeric IDs from
# its market-district-state list. More states means wider
# coverage but a slower first fetch, since each state is a
# separate request.
#
# 20 Maharashtra   34 Uttar Pradesh   28 Punjab
# 19 Madhya Pradesh 16 Karnataka      11 Gujarat
# 32 Telangana     36 West Bengal     29 Rajasthan
# 12 Haryana       2 Andhra Pradesh   26 Odisha
AGMARKNET_STATES=

# Fallback source: a community mirror of the same Agmarknet mandi
# records, consulted only for turmeric. Agmarknet publishes no
# turmeric line and neither does DOCA, so without this source
# turmeric would have no price at all. It is not used for any
# other crop.
#
# It is a third-party service with no uptime promise and a hard
# limit of 100 requests per 15 minutes per IP, shared by every
# instance behind the same egress address. GroWell caches each
# crop for 30 minutes and collapses concurrent requests, so a full
# twelve-crop page costs one request per crop rather than one per
# viewer. Prices carry the arrival date the mirror recorded, which
# lags the current day, and that date is always shown.
#
# Set to false to remove the source entirely, e.g. if you would
# rather show a dated snapshot than a third-party price.
MANDI_MIRROR_ENABLED=true
MANDI_MIRROR_URL=https://mandi-api.onrender.com
